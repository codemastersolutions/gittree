{
  "name": "@codemastersolutions/gittree-cli",
  "version": "0.1.0",
  "description": "GitTree CLI - Command-line interface for managing Git worktrees, branches and repository sync",
  "license": "MIT",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemastersolutions/gittree.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/codemastersolutions/gittree/issues"
  },
  "homepage": "https://github.com/codemastersolutions/gittree/tree/develop/packages/cli#readme",
  "author": "CodeMaster Soluções <gilson@codemastersolutions.com>",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/codemastersolutions"
    }
  ],
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "cli",
    "branch",
    "productivity",
    "monorepo",
    "sync",
    "developer-tools",
    "gittree",
    "gtree",
    "codemaster",
    "soluções",
    "solutions"
  ],
  "bin": {
    "gittree": "./bin/gittree.js",
    "gtree": "./bin/gittree.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.pt-br.md",
    "README.es.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ./tsup.config.ts && pnpm run build:dts",
    "build:dts": "tsc -p tsconfig.dts.json",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemastersolutions/gittree-core": "workspace:*",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.2.4"
  }

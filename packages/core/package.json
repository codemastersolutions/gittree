{
  "name": "@codemastersolutions/gittree-core",
  "version": "0.1.0",
  "description": "GitTree core engine - shared logic for managing Git worktrees, branches and sync operations",
  "license": "MIT",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemastersolutions/gittree.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/codemastersolutions/gittree/issues"
  },
  "homepage": "https://github.com/codemastersolutions/gittree/tree/develop/packages/core#readme",
  "author": "CodeMaster Soluções <gilson@codemastersolutions.com>",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "core",
    "library",
    "branch",
    "sync",
    "developer-tools",
    "gittree"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.pt-br.md",
    "README.es.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ./tsup.config.ts && pnpm run build:dts",
    "dev": "tsup --config ./tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "build:dts": "tsc -p tsconfig.dts.json"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.2.4"
  }
}

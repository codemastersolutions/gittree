# ============================================================
# pnpm workspace configuration (GitTree monorepo)
# ============================================================
# Workspace graph
link-workspace-packages = true
prefer-workspace-packages = true

# Peer deps
auto-install-peers = true
strict-peer-dependencies = false

# --- HOISTING CRÍTICO PARA ESLINT 9 FLATCONFIG + VITEST ----
# ESLint 9 carrega .mjs config via ESM resolve (import.meta.resolve)
# e requer @eslint/js / @typescript-eslint/* VISÍVEIS como symlinks
# DIRETAMENTE em `node_modules/` do ROOT (não apenas dentro de
# `node_modules/.pnpm/...`). Sem isso: ERR_MODULE_NOT_FOUND.
#
# shamefully-hoist = true ⇒ todos pacotes de DEV sobem para ROOT
# node_modules, igual npm antigo. Funciona 100% com flatConfig e
# bundlers (esbuild, tsup) que scan node_modules direto.
# Alternativa mais restrita: usar public-hoist-pattern[] abaixo.
shamefully-hoist = true

# Como double-check (não conflita com shamefully-hoist):
public-hoist-pattern[]=eslint*
public-hoist-pattern[]=@eslint/*
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=eslint-plugin-*
public-hoist-pattern[]=eslint-config-*
public-hoist-pattern[]=prettier*
public-hoist-pattern[]=typescript*
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=vitest*
public-hoist-pattern[]=@vitest/*
public-hoist-pattern[]=tsup*
public-hoist-pattern[]=esbuild*
public-hoist-pattern[]=@vscode/*
public-hoist-pattern[]=ts-node*
public-hoist-pattern[]=@rollup/*
public-hoist-pattern[]=rollup*
public-hoist-pattern[]=@codemastersolutions/*

# Node linker = hoisted mantém estrutura conhecida.
node-linker = hoisted

# Prepare scripts automáticos (husky / commitzero hooks):
enable-pre-post-scripts = true

# Performance e cache
fetch-retries = 5
fetch-timeout = 90000
network-concurrency = 8

# Não gerar node_modules/.pnpm quando não necessário (reduz ruído):
# (ignorado se shamefully-hoist = true, mas sem malefício)
global-pnpm-bin-path = true

{
  "name": "@codemastersolutions/gittree",
  "private": true,
  "version": "0.1.0",
  "description": "GitTree - Git ecosystem tools: CLI and VS Code extension for managing worktrees",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemastersolutions/gittree.git"
  },
  "bugs": {
    "url": "https://github.com/codemastersolutions/gittree/issues"
  },
  "homepage": "https://github.com/codemastersolutions/gittree#readme",
  "author": "CodeMaster Soluções <gilson@codemastersolutions.com>",
  "keywords": [
    "git",
    "worktree",
    "cli",
    "vscode",
    "vscode-extension",
    "branch",
    "productivity",
    "monorepo"
  ],
  "scripts": {
    "build": "pnpm --filter @codemastersolutions/gittree-core run build && pnpm --filter @codemastersolutions/gittree-cli run build && pnpm --filter gittree-vscode run build",
    "dev": "taskly --names core,cli,vscode --prefix name --prefix-colors blue,green,magenta \"pnpm --filter @codemastersolutions/gittree-core run dev\" \"pnpm --filter @codemastersolutions/gittree-cli run dev\" \"pnpm --filter gittree-vscode run dev\"",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules .commitzero/hooks",
    "commitzero": "commitzero",
    "commitzero:install": "commitzero install-hooks --init-git",
    "commitzero:uninstall": "commitzero uninstall-hooks",
    "commit": "commitzero commit -a",
    "commit:push": "commitzero commit -a -p",
    "lint:staged": "lint-staged",
    "audit": "pnpm audit --prod",
    "release": "pnpm dlx commit-and-tag-version@12 -a --commitAll",
    "release:dry-run": "pnpm dlx commit-and-tag-version@12 --dry-run -a",
    "release:major": "pnpm run release --release-as major",
    "release:minor": "pnpm run release --release-as minor",
    "release:patch": "pnpm run release --release-as patch",
    "release:first": "pnpm run release --first-release"
  },
  "commit-and-tag-version": {
    "$schema": "https://json.schemastore.org/commit-and-tag-version.json",
    "tag-prefix": "v",
    "commitAll": true,
    "sign": false,
    "scripts": {
      "precommit": "node -e \"const v=require('./package.json').version; const paths=['packages/cli','packages/core','packages/vscode']; for(const p of paths){const f=p+'/package.json'; const j=JSON.parse(require('fs').readFileSync(f,'utf8')); j.version=v; require('fs').writeFileSync(f, JSON.stringify(j,null,2)+String.fromCharCode(10));}\" && git add packages/*/package.json"
    },
    "bumpFiles": [
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "packageFiles": [
      {
        "filename": "package.json",
        "type": "json"
      }
    ],
    "types": [
      {
        "type": "feat",
        "section": "✨ Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "perf",
        "section": "⚡ Performance"
      },
      {
        "type": "revert",
        "section": "↩️ Reverts"
      },
      {
        "type": "docs",
        "section": "📝 Docs",
        "hidden": false
      },
      {
        "type": "style",
        "section": "🎨 Estilo",
        "hidden": true
      },
      {
        "type": "refactor",
        "section": "♻️ Refactor",
        "hidden": false
      },
      {
        "type": "test",
        "section": "✅ Testes",
        "hidden": true
      },
      {
        "type": "build",
        "section": "📦 Build",
        "hidden": false
      },
      {
        "type": "ci",
        "section": "🤖 CI",
        "hidden": false
      },
      {
        "type": "chore",
        "section": "🧹 Chore",
        "hidden": true
      }
    ],
    "issueUrlFormat": "{{host}}/{{owner}}/{{repository}}/issues/{{id}}",
    "commitUrlsFormat": "{{host}}/{{owner}}/{{repository}}/commit/{{hash}}",
    "compareUrlFormat": "{{host}}/{{owner}}/{{repository}}/compare/{{previousTag}}...{{currentTag}}"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@codemastersolutions/commitzero": "^0.0.55",
    "@codemastersolutions/taskly": "^0.1.2",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/*/src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}

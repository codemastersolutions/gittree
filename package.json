{
  "name": "gittree-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "GitTree - Git ecosystem tools: CLI and VS Code extension for managing worktrees",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @gittree/core && npm run build -w @gittree/cli && npm run build -w @gittree/vscode",
    "dev": "concurrently -n core,cli,vscode -c blue,green,magenta \"npm run dev -w @gittree/core\" \"npm run dev -w @gittree/cli\" \"npm run dev -w @gittree/vscode\"",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "prepare": "husky",
    "audit": "npm audit --production"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/*/src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
